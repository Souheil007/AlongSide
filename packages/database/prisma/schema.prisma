datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  PARENT
  CO_PARENT
  ADMIN
}

enum SubscriptionTier {
  TRIAL             // 7-day upfront trial
  ANNUAL_HERO       // $79/year (Hero Offer)
  MONTHLY_FLEX      // $9.99/month
  INSTITUTIONAL     // School / PTA / Pediatrician partnership license
}

enum RoadType {
  PRE_DEVICE        // Road 1: No personal smartphone yet (Ages 8–11+)
  ACTIVE_DEVICE     // Road 2: Already owns personal smartphone (Ages 9–14+)
}

enum Gender {
  MALE              // Male / Boy
  FEMALE            // Female / Girl
}

enum DevelopmentalTier {
  TIER_0A_INFANCY_0_1          // Ages 0–1 / 0–12m: Somatic Regulation, Sleep Architecture & Feeding Foundations
  TIER_0B_TODDLER_1_2          // Ages 1–2 / 12–24m: Locomotion, First Words & Amygdala Co-Regulation
  TIER_0C_OLDER_TODDLER_2_3    // Ages 2–3 / 24–36m: Autonomy, Language Burst, Boundary Testing & Potty Learning
  TIER_0_INFANCY_TODDLER_0_3   // Preserved for backward compatibility (Ages 0–3)
  TIER_1_EARLY_CHILDHOOD_4_6   // Ages 4–6: Preschool, Theory of Mind, Blocks, Picky Eating
  TIER_2_MIDDLE_CHILDHOOD_7_9  // Ages 7–9: Elementary, Logic Puzzles, Sports, Sleep
  TIER_3_PRE_TEEN_10_12        // Ages 10–12: Adrenarche, Device Readiness, Slang, Peers
  TIER_4_EARLY_ADOLESCENCE_13_15// Ages 13–15: Puberty, Circadian Delay, Pacts, 8:30 Curfew
  TIER_5_LATE_ADOLESCENCE_16_18// Ages 16–18: Executive Autonomy, Consequence, Self-Regulation

  // Legacy compatibility aliases (v2.3)
  TIER_1_AGES_8_9
  TIER_2_AGES_10_11
  TIER_3_AGES_12_13
  TIER_4_AGES_14_PLUS
}

// v2.4.0 Holistic Enums
enum DietaryStage {
  MILK_ONLY           // Exclusive breastmilk / formula (0–6m)
  SOLIDS_INTRODUCED   // Purees & Baby-Led Weaning (6–12m)
  TODDLER_TABLE       // Self-feeding, division of responsibility (1–5y)
  BALANCED_SCHOOL     // School lunchboxes, sustained energy (6–12y)
  PUBERTAL_GROWTH     // High calcium, iron & athletic fuel (13–18y)
}

enum MilestoneCategory {
  GROSS_MOTOR
  FINE_MOTOR
  SPEECH_LANGUAGE
  COGNITIVE
  SOCIAL_EMOTIONAL
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
}

enum PlayCategory {
  PUPPET
  SENSORY
  CONSTRUCTION
  LOGIC_PUZZLE
  MAKER
  BOREDOM_BUSTER
}

enum AgreementStatus {
  DRAFT
  SIGNED
  DEPLOYED_TO_DEVICE
  ARCHIVED
}

enum ClauseCategory {
  SCREEN_TIME
  DEVICE_CURFEW
  PRIVACY_SAFETY
  PURCHASES_CHATS
  CONTENT_BOUNDARIES
  PARENT_COMMITMENT
}

enum CommitmentParty {
  CHILD
  PARENT
}

enum DeviceProfileStatus {
  PENDING_ENROLLMENT
  ACTIVE
  REVOKED
  EXPIRED
}

enum DevicePlatform {
  APPLE_IOS
  ANDROID_ENTERPRISE
}

enum QuizType {
  CULTURAL_FLUENCY_TWEEN    // "Do You Speak Tween?" Slang Quiz
  PARENTING_STYLE_CONFLICT  // Parenting Style & Conflict Profiler
  FIRST_PHONE_READINESS     // 10-dimension Readiness Assessment (Score 0–100)
  HOUSEHOLD_SCREEN_AUDIT    // Tech Health & Evening Sleep Friction Audit
  JOINT_DISCOVERY_BRIDGE    // Joint Parent-Child Values Quiz
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ExploitSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DigestIssueStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DigestContentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DigestItemType {
  ARTICLE
  VIDEO
  DINNER_PROMPT
}

enum AcademyCategory {
  BEHAVIOR_AND_EMOTIONS
  HEALTH_AND_WELLNESS
  NUTRITION_AND_FEEDING
  DEVELOPMENT_AND_PLAY
  DIGITAL_AND_DEVICES
}

// ----------------------------------------------------
// USER & SUBSCRIPTION MODELS
// ----------------------------------------------------

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  fullName          String
  role              Role               @default(PARENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  children          Child[]
  agreements        Agreement[]
  quizAttempts      QuizAttempt[]
  academyProgress    AcademyProgress[]
  aiConversations    AiConversation[]
  digestInteractions UserDigestInteraction[]
  subscription       Subscription?

  @@map("users")
}

model Subscription {
  id                     String           @id @default(uuid())
  userId                 String           @unique
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                   SubscriptionTier @default(TRIAL)
  isActive               Boolean          @default(true)
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  stripeCustomerId       String?          @unique
  stripeSubscriptionId   String?          @unique
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@map("subscriptions")
}

// ----------------------------------------------------
// CHILD & DEVICE MODELS
// ----------------------------------------------------

model Child {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  birthYear         Int
  birthMonth        Int
  birthDate         DateTime?
  roadType          RoadType          @default(PRE_DEVICE)
  developmentalTier DevelopmentalTier
  gender            Gender
  dietaryStage      DietaryStage      @default(TODDLER_TABLE)
  allergies         String[]          @default([])
  pediatricNotes    String?
  schoolGrade       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  agreements        Agreement[]
  deviceProfiles    DeviceProfile[]
  quizAttempts      QuizAttempt[]
  milestones        ChildMilestone[]

  @@index([userId])
  @@map("children")
}

model DeviceProfile {
  id                String              @id @default(uuid())
  childId           String
  child             Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  agreementId       String?             @unique
  agreement         Agreement?          @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  platform          DevicePlatform      @default(APPLE_IOS)
  status            DeviceProfileStatus @default(PENDING_ENROLLMENT)
  enrollmentToken   String              @unique @default(uuid())
  bedtimeCurfewTime String              @default("20:30") // 8:30 PM default
  isLockdownActive  Boolean             @default(false)
  tamperDetected    Boolean             @default(false)
  enrolledAt        DateTime?
  lastHeartbeatAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([childId])
  @@index([enrollmentToken])
  @@map("device_profiles")
}

// ----------------------------------------------------
// BILATERAL FAMILY PACT & AGREEMENT MODELS
// ----------------------------------------------------

model Agreement {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId            String
  child              Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  title              String
  status             AgreementStatus  @default(DRAFT)
  developmentalTier  DevelopmentalTier
  roadType           RoadType         @default(ACTIVE_DEVICE)
  parentSignature    String?
  childSignature     String?
  signedAt           DateTime?
  pdfExportUrl       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  clauses            AgreementClause[]
  deviceProfile      DeviceProfile?

  @@index([userId])
  @@index([childId])
  @@map("agreements")
}

model AgreementClause {
  id                 String          @id @default(uuid())
  agreementId        String
  agreement          Agreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  category           ClauseCategory
  party              CommitmentParty
  title              String
  description        String
  isStandard         Boolean         @default(true)
  isCustom           Boolean         @default(false)
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([agreementId])
  @@map("agreement_clauses")
}

// ----------------------------------------------------
// INTERACTIVE QUIZZES & ASSESSMENTS
// ----------------------------------------------------

model Quiz {
  id                 String         @id @default(uuid())
  type               QuizType       @unique
  title              String
  description        String
  estimatedMinutes   Int            @default(3)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  questions          QuizQuestion[]
  attempts           QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id                 String         @id @default(uuid())
  quizId             String
  quiz               Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText       String
  explanation        String?
  dimensionKey       String?        // e.g. "executive_function", "social_awareness"
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  options            QuizOption[]
  responses          QuizResponse[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id                 String         @id @default(uuid())
  questionId         String
  question           QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText         String
  scoreWeight        Int            @default(0)
  isCorrect          Boolean        @default(false)
  feedbackText       String?
  sortOrder          Int            @default(0)

  responses          QuizResponse[]

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id                 String         @id @default(uuid())
  quizId             String
  quiz               Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId            String?
  child              Child?         @relation(fields: [childId], references: [id], onDelete: SetNull)
  overallScore       Int            @default(0) // 0-100 score
  dimensionScores    Json?          // { "executive_function": 85, "online_safety": 70 }
  completedAt        DateTime       @default(now())

  responses          QuizResponse[]

  @@index([userId])
  @@index([childId])
  @@map("quiz_attempts")
}

model QuizResponse {
  id                 String         @id @default(uuid())
  attemptId          String
  attempt            QuizAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId         String
  question           QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId   String
  selectedOption     QuizOption     @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("quiz_responses")
}

// ----------------------------------------------------
// PARENT INTELLIGENCE ACADEMY
// ----------------------------------------------------

model AcademyModule {
  id                   String             @id @default(uuid())
  category             AcademyCategory    @default(DIGITAL_AND_DEVICES)
  developmentalTier    DevelopmentalTier
  slug                 String             @unique
  title                String
  summary              String
  reliefSubtitle       String?
  tonightQuickWinTitle String?
  coverImageUrl        String?
  featuredVideoLecture Json?
  sortOrder            Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  chapters             AcademyChapter[]
  lessons              AcademyLesson[]

  @@index([category, developmentalTier])
  @@map("academy_modules")
}

model AcademyChapter {
  id                 String             @id @default(uuid())
  moduleId           String
  module             AcademyModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug               String
  title              String
  summary            String
  priority           Int                @default(1)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  lessons            AcademyLesson[]

  @@unique([moduleId, slug])
  @@map("academy_chapters")
}

model AcademyLesson {
  id                 String             @id @default(uuid())
  moduleId           String
  module             AcademyModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  chapterId          String?
  chapter            AcademyChapter?    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  slug               String
  title              String
  archetype          String             @default("EVERYDAY_BEHAVIOR")
  episodeRole        String             @default("FAST_WIN")
  contentMarkdown    String
  readingMinutes     Int                @default(4)
  sortOrder          Int                @default(0)
  audioUrl           String?
  audioDurationSeconds Int?
  whatNotToSay       String?
  deliveryTip        String?
  reliefTagline      String?
  thirtySecondGlance Json?
  adaptiveModuleType String?
  dialogueCards      Json?
  videoLecture       Json?
  almanacPayload     Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  progressRecords    AcademyProgress[]

  @@unique([moduleId, slug])
  @@map("academy_lessons")
}

model AcademyProgress {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             AcademyLesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted        Boolean            @default(true)
  completedAt        DateTime           @default(now())
  chosenMoveId       String?
  bookmarkedTruth    Boolean            @default(false)
  savedPushbackIds   String[]           @default([])

  @@unique([userId, lessonId])
  @@map("academy_progress")
}

// ----------------------------------------------------
// 24/7 AI ADVISOR & FAQ VAULT
// ----------------------------------------------------

model AiConversation {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId            String?
  title              String             @default("Parenting Discussion")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  messages           AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id                 String             @id @default(uuid())
  conversationId     String
  conversation       AiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role               MessageRole
  content            String
  matchedFaqIds      String[]           @default([])
  tokensUsed         Int                @default(0)
  createdAt          DateTime           @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model FaqCategory {
  id                 String             @id @default(uuid())
  slug               String             @unique
  name               String
  description        String
  sortOrder          Int                @default(0)

  faqs               FaqItem[]

  @@map("faq_categories")
}

model FaqItem {
  id                 String             @id @default(uuid())
  categoryId         String
  category           FaqCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  targetTier         DevelopmentalTier?
  targetRoad         RoadType?
  question           String
  answerMarkdown     String
  deEscalationScript String?
  isFeatured         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([categoryId])
  @@map("faq_items")
}

// ----------------------------------------------------
// YOUTH CULTURE DIGEST & PLATFORM DECODERS
// ----------------------------------------------------

model CultureDigest {
  id                  String               @id @default(uuid())
  issueNumber         Int                  @unique
  publishDate         DateTime             @default(now())
  weekStart           DateTime             @default(now())
  weekEnd             DateTime             @default(now())
  title               String
  summary             String
  conversationStarter String               // Sunday dinner question
  status              DigestIssueStatus    @default(PUBLISHED)
  curatedAt           DateTime?
  createdAt           DateTime             @default(now())

  slangTerms          SlangTerm[]
  exploitAlerts       ExploitAlert[]
  articles            DigestArticle[]
  videos              DigestVideo[]
  dinnerPrompts       DigestDinnerPrompt[]
  phrases             DigestPhrase[]

  @@map("culture_digests")
}

model DigestArticle {
  id                  String              @id @default(uuid())
  digestId            String
  digest              CultureDigest       @relation(fields: [digestId], references: [id], onDelete: Cascade)
  canonicalHash       String
  sourceUrl           String
  sourceName          String
  sourceDomain        String
  authorName          String?
  imageUrl            String?
  publishedAt         DateTime
  isOriginalEditorial Boolean             @default(false)
  topicLabel          String
  readMinutes         Int                 @default(3)
  title               String
  summary             String
  keyShift            String
  perspectiveNote     String?
  contentMarkdown     String?
  sourcesText         String?
  targetTiers         DevelopmentalTier[]
  isLead              Boolean             @default(false)
  sortOrder           Int                 @default(0)
  ingestionStatus     DigestContentStatus @default(APPROVED)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([digestId, canonicalHash])
  @@index([digestId, ingestionStatus, sortOrder])
  @@map("digest_articles")
}

model DigestVideo {
  id              String              @id @default(uuid())
  digestId        String
  digest          CultureDigest       @relation(fields: [digestId], references: [id], onDelete: Cascade)
  youtubeVideoId  String
  videoUrl        String
  title           String
  presenter       String
  channelName     String
  channelId       String?
  publishedAt     DateTime
  durationMinutes Int
  formatLabel     String
  takeaway        String
  jumpChips       Json?
  skimBullets     String[]            @default([])
  targetTiers     DevelopmentalTier[]
  isEmbeddable    Boolean             @default(true)
  sortOrder       Int                 @default(0)
  ingestionStatus DigestContentStatus @default(APPROVED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([digestId, youtubeVideoId])
  @@index([digestId, ingestionStatus, sortOrder])
  @@map("digest_videos")
}

model DigestDinnerPrompt {
  id          String              @id @default(uuid())
  digestId    String
  digest      CultureDigest       @relation(fields: [digestId], references: [id], onDelete: Cascade)
  question    String
  parentTip   String
  followUp    String
  targetTiers DevelopmentalTier[]
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())

  @@index([digestId, sortOrder])
  @@map("digest_dinner_prompts")
}

model DigestPhrase {
  id           String              @id @default(uuid())
  digestId     String
  digest       CultureDigest       @relation(fields: [digestId], references: [id], onDelete: Cascade)
  word         String
  shortMeaning String
  fullMeaning  String
  cringeLevel  Int                 @default(2)
  cringeLabel  String
  calmScript   String
  targetTiers  DevelopmentalTier[]
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([digestId, sortOrder])
  @@map("digest_phrases")
}

model UserDigestInteraction {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId   String?
  itemType  DigestItemType
  itemId    String
  isRead    Boolean        @default(false)
  readAt    DateTime?
  isSaved   Boolean        @default(false)
  savedAt   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, itemType, itemId])
  @@index([userId, isSaved])
  @@index([userId, itemType, isRead])
  @@map("user_digest_interactions")
}

model SlangTerm {
  id                 String             @id @default(uuid())
  digestId           String?
  digest             CultureDigest?     @relation(fields: [digestId], references: [id], onDelete: SetNull)
  term               String             @unique
  definition         String
  exampleSentence    String
  contextTone        String             // e.g. "Harmless play", "Sarcastic", "Toxic flag"
  createdAt          DateTime           @default(now())

  @@map("slang_terms")
}

model ExploitAlert {
  id                 String             @id @default(uuid())
  digestId           String?
  digest             CultureDigest?     @relation(fields: [digestId], references: [id], onDelete: SetNull)
  appName            String
  exploitDescription String
  howKidsBypass      String
  parentRemedy       String
  severity           ExploitSeverity    @default(MEDIUM)
  createdAt          DateTime           @default(now())

  @@map("exploit_alerts")
}

// ----------------------------------------------------
// HOLISTIC CHILD UPBRINGING & PEDIATRIC HEALTH (v2.4.0)
// ----------------------------------------------------

model Milestone {
  id                String            @id @default(uuid())
  targetTier        DevelopmentalTier
  targetAgeMonths   Int
  category          MilestoneCategory
  title             String
  description       String
  signsToWatch      String
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  childMilestones   ChildMilestone[]

  @@index([targetTier])
  @@index([category])
  @@map("milestones")
}

model ChildMilestone {
  id                String            @id @default(uuid())
  childId           String
  child             Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  milestoneId       String
  milestone         Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  status            MilestoneStatus   @default(NOT_STARTED)
  achievedAt        DateTime?
  parentNotes       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([childId, milestoneId])
  @@index([childId])
  @@map("child_milestones")
}

model NutritionGuide {
  id                String            @id @default(uuid())
  stage             DietaryStage      @unique
  title             String
  ageBracket        String
  guidelinesMarkdown String
  safeFoods         String[]
  chokingHazards    String[]
  allergenProtocol  String?
  pickyEatingTips   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("nutrition_guides")
}

model BrainGameActivity {
  id                String            @id @default(uuid())
  targetTier        DevelopmentalTier
  category          PlayCategory
  title             String
  summary           String
  instructions      String
  materialsNeeded   String[]          @default([])
  targetSkills      String[]
  estimatedMinutes  Int               @default(15)
  isScreenFree      Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([targetTier])
  @@index([category])
  @@map("brain_game_activities")
}

model BehaviorGuide {
  id                String            @id @default(uuid())
  targetTier        DevelopmentalTier
  slug              String            @unique
  triggerSituation  String
  underlyingNeed    String            // Translating behavior into neurological/emotional need
  coRegulationScript String           // Word-for-word calm dialogue script
  authoritativeLimit String           // Firm loving boundary
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([targetTier])
  @@map("behavior_guides")
}
