# -----------------------------------------------------------------------------
# Alongside Environment Variables Configuration
# Copy this file to .env before starting the development environment
# -----------------------------------------------------------------------------

# Application Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alongside_dev?schema=public

# Authentication & JWT Secrets
# Generate a secure 64-character secret using: openssl rand -base64 48
JWT_SECRET=super_secret_alongside_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_32_chars_minimum

# Stripe Billing (Phase 1 MVP Monetization)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_ID_MONTHLY=price_monthly_test
STRIPE_PRICE_ID_ANNUAL=price_annual_test

# Client Environment (Exposed to Next.js Frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
