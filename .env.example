# -----------------------------------------------------------------------------
# Alongside Environment Variables Configuration
# Copy this file to .env before starting the development environment
# -----------------------------------------------------------------------------

# Application Server Environment
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alongside_dev?schema=public

# Authentication & Session Secrets
# CRITICAL: In production (NODE_ENV=production), JWT_SECRET and COOKIE_SECRET must be explicitly
# configured with unique, random secrets of at least 32 characters.
# Generate a secure 64-character secret using: openssl rand -base64 48
JWT_SECRET=super_secret_alongside_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_32_chars_minimum

# AI Model Provider Configurations (24/7 AI Child Advisor & Embedding Engine)
# OpenAI (Default Advisor & Embedding Provider)
OPENAI_API_KEY=sk-placeholder_key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Multi-Provider Fallback 1)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI (Multi-Provider Fallback 2)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b

# Apple Declarative Device Management (DDM) / MobileConfig Signing
# Optional in development: when omitted, profiles are delivered as unsigned XML plists.
# In production, provide PEM-formatted PKCS#7 cryptographic signing certificate and private key.
# APPLE_MDM_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# APPLE_MDM_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Live DNS Parental Control Shield (PLAN-52)
# Optional in development: when NEXTDNS_API_KEY is omitted in non-production, falls back to InMemoryDnsPolicyFake.
# Set DNS_PROVIDER=nextdns and NEXTDNS_API_KEY to provision real per-child DoH/DoT profiles via NextDNS API.
# DNS_PROVIDER=nextdns
# NEXTDNS_API_KEY=your_nextdns_api_key_here

# Stripe Billing (Phase 1 MVP Monetization)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_ID_MONTHLY=price_monthly_test
STRIPE_PRICE_ID_ANNUAL=price_annual_test

# Culture & Trends Weekly Live Sourcing Pipeline (PLAN-50)
# Optional: When set, enables YouTube Data API v3 batch videos.list verification
# (embeddability + exact ISO-8601 duration) and supplemental sparse-tier search.list discovery.
# When omitted, the pipeline runs zero-quota channel Atom feeds + YouTube oEmbed playability checks.
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Optional shared secret for automated Sunday 05:00 UTC cron calls to POST /api/v1/digest/issues/sync
# via the X-Digest-Sync-Secret request header (constant-time verified).
# DIGEST_SYNC_SECRET=replace_with_32_plus_char_random_sync_secret

# Client Environment (Exposed to Next.js Frontend)
# Note: Do not append /api/v1 here; the API client appends /api/v1 paths automatically.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Passwordless Auth: Continue with Google OAuth 2.0 + PKCE (Optional; hides Google button when unset)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# API_PUBLIC_URL=http://localhost:4000
# APP_PUBLIC_URL=http://localhost:3000
